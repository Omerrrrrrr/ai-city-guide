            "value": "Valgfritt — brukes til å tilpasse hvordan Piri snakker med deg."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional — usado para personalizar como o Piri fala com você."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsteğe bağlı — Piri'nin seninle konuşma şeklini kişiselleştirmek için kullanılır."
          }
        }
      }
    },
    "onboarding.name.title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie sollen wir dich nennen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What should we call you?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cómo quieres que te llamemos?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment doit-on t'appeler ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come possiamo chiamarti?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hva skal vi kalle deg?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como podemos te chamar?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sana nasıl hitap edelim?"
          }
        }
      }
    },
    "onboarding.profession.subtitle": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Piri passt seine Erklärungen an dein Fachwissen an. Ein Architekt hört mehr über die Struktur, ein Historiker mehr über den Kontext."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Piri tailors its explanations to your expertise. An architect hears about structure; a historian about context."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Piri adapta sus explicaciones a tu perfil. Un arquitecto escucha sobre estructura; un historiador, sobre contexto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Piri adapte ses explications à ton domaine. Un architecte entendra parler de structure, un historien de contexte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Piri adatta le sue spiegazioni alla tua competenza. Un architetto sente parlare di struttura, uno storico di contesto."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Piri tilpasser forklaringene til din ekspertise. En arkitekt hører om struktur; en historiker om kontekst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Piri adapta suas explicações à sua área de conhecimento. Um arquiteto ouve sobre estrutura; um historiador, sobre contexto."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Piri açıklamalarını uzmanlığına göre uyarlar. Bir mimar yapıyı duyar; bir tarihçi bağlamı."
          }
        }
      }
    },
    "onboarding.profession.title": {
      "localizations": {
