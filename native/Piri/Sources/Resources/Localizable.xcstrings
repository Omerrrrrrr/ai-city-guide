    "components.errorBoundary.body": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app hit an unexpected error. You can try again, or restart the app if it keeps happening."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen støtte på en uventet feil. Du kan prøve igjen, eller starte appen på nytt hvis det fortsetter."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama beklenmedik bir hatayla karşılaştı. Tekrar deneyebilir veya sorun devam ederse uygulamayı yeniden başlatabilirsin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app encontró un error inesperado. Puedes intentarlo de nuevo o reiniciar la app si sigue ocurriendo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der App ist ein unerwarteter Fehler aufgetreten. Du kannst es erneut versuchen oder die App neu starten, falls es weiter passiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'application a rencontré une erreur inattendue. Réessaie, ou redémarre l'application si le problème persiste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si è verificato un errore imprevisto nell'app. Puoi riprovare oppure riavviare l'app se il problema persiste."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app encontrou um erro inesperado. Tente novamente ou reinicie o app se o problema persistir."
          }
        }
      }
    },
