          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand tu commenceras ce plan — utilisé pour vérifier si chaque lieu sera déjà ouvert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando inizierai questo piano — usato per verificare se ogni luogo sarà già aperto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você vai começar esse plano — usado para verificar se cada local já estará aberto."
          }
        }
      }
    },
    "collection.delete.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently deletes the list and every place saved in it."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette sletter listen og alle stedene lagret i den permanent."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, listeyi ve içindeki tüm kayıtlı yerleri kalıcı olarak siler."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina permanentemente la lista y todos los lugares guardados en ella."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden die Liste und alle darin gespeicherten Orte endgültig gelöscht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime définitivement la liste et tous les lieux qu'elle contient."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa azione eliminerà definitivamente la lista e tutti i luoghi salvati al suo interno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso exclui permanentemente a lista e todos os locais salvos nela."
          }
        }
      }
    },
