    "settings.account.signedOutNote": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich an, um deine gespeicherten Orte, Pläne und Reisen beim Gerätewechsel zu behalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to keep your saved places, plans, and trips when you switch devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión para conservar tus lugares guardados, planes y viajes al cambiar de dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecte-toi pour conserver tes lieux enregistrés, tes plans et tes voyages en changeant d'appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi per mantenere i tuoi luoghi salvati, piani e viaggi quando cambi dispositivo."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Logg inn for å beholde lagrede steder, planer og turer når du bytter enhet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre para manter seus locais salvos, planos e viagens ao trocar de dispositivo."
