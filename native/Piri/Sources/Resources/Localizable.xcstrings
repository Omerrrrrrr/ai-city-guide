    "paywall.autoRenew.monthly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payment charged to your Apple ID account. Subscription automatically renews monthly unless canceled at least 24 hours before the end of the current period. Manage or cancel anytime in your Apple ID account settings."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Betaling belastes din Apple ID-konto. Abonnementet fornyes automatisk hver måned med mindre det sies opp minst 24 timer før inneværende periode utløper. Administrer eller si opp når som helst i Apple ID-kontoinnstillingene."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ödeme Apple ID hesabınızdan tahsil edilir. Mevcut dönem bitmeden en az 24 saat önce iptal edilmediği sürece abonelik her ay otomatik olarak yenilenir. Apple ID hesap ayarlarınızdan istediğiniz zaman yönetebilir veya iptal edebilirsiniz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pago se cargará a tu cuenta de Apple ID. La suscripción se renueva automáticamente cada mes, salvo que la canceles al menos 24 horas antes de que finalice el período actual. Puedes gestionarla o cancelarla en cualquier momento desde los ajustes de tu cuenta de Apple ID."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahlung wird über Ihre Apple-ID abgerechnet. Das Abo verlängert sich automatisch monatlich, sofern es nicht mindestens 24 Stunden vor Ablauf des aktuellen Zeitraums gekündigt wird. Sie können es jederzeit in den Einstellungen Ihrer Apple-ID verwalten oder kündigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paiement est débité sur ton compte Apple ID. L'abonnement se renouvelle automatiquement chaque mois, sauf annulation au moins 24 heures avant la fin de la période en cours. Gère ou annule à tout moment dans les réglages de ton compte Apple ID."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pagamento verrà addebitato sul tuo account Apple ID. L'abbonamento si rinnova automaticamente ogni mese, a meno che non venga disdetto almeno 24 ore prima della fine del periodo in corso. Puoi gestirlo o annullarlo in qualsiasi momento nelle impostazioni del tuo account Apple ID."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pagamento é cobrado na sua conta Apple ID. A assinatura é renovada automaticamente todo mês, a menos que seja cancelada com pelo menos 24 horas de antecedência do fim do período atual. Gerencie ou cancele quando quiser nas configurações da sua conta Apple ID."
          }
        }
      }
    },
    "paywall.autoRenew.yearly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payment charged to your Apple ID account. Subscription automatically renews yearly unless canceled at least 24 hours before the end of the current period. Manage or cancel anytime in your Apple ID account settings."
