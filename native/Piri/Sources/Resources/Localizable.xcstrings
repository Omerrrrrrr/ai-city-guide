    "adminHours.formatHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use `HH:MM-HH:MM` and separate multiple windows with commas. Leave blank for closed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "`HH:MM-HH:MM` kullan ve birden fazla aralığı virgülle ayır. Kapalıysa boş bırak."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk `TT:MM-TT:MM` og skill flere intervaller med komma. La stå tomt for stengt."
          }
        }
      }
    },
    "adminHours.googlePreviewBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull a candidate from Google Places, inspect the match, then save only if it looks right."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Places'ten bir aday çek, eşleşmeyi incele, sadece doğru görünüyorsa kaydet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hent en kandidat fra Google Places, inspiser treffet, og lagre kun hvis det ser riktig ut."
          }
        }
      }
    },
    "adminHours.googlePreviewTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Preview"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Önizlemesi"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Google-forhåndsvisning"
          }
        }
      }
    },
    "adminHours.hero.body1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save verified opening hours, source links, and temporary closures without editing seed data."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seed veriyi düzenlemeden doğrulanmış çalışma saatlerini, kaynak linklerini ve geçici kapanışları kaydet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagre verifiserte åpningstider, kildelenker og midlertidige stenginger uten å redigere seed-data."
          }
        }
      }
    },
    "adminHours.hero.body2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google preview only prefills the form. Nothing becomes live until you inspect it and press Save Hours."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google önizlemesi sadece formu doldurur. Sen inceleyip Saatleri Kaydet'e basana kadar hiçbir şey canlıya çıkmaz."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Google-forhåndsvisning fyller kun ut skjemaet. Ingenting blir live før du inspiserer det og trykker Lagre åpningstider."
          }
        }
      }
    },
    "adminHours.hero.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
