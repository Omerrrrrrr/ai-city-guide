    "adminHours.formatHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use `HH:MM-HH:MM` and separate multiple windows with commas. Leave blank for closed."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk `TT:MM-TT:MM` og skill flere intervaller med komma. La stå tomt for stengt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "`HH:MM-HH:MM` kullan ve birden fazla aralığı virgülle ayır. Kapalıysa boş bırak."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el formato `HH:MM-HH:MM` y separa varios intervalos con comas. Déjalo en blanco si está cerrado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende `HH:MM-HH:MM` und trenne mehrere Zeitfenster mit Kommas. Leer lassen, wenn geschlossen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise le format `HH:MM-HH:MM` et sépare les plages par des virgules. Laisse vide si fermé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa il formato `HH:MM-HH:MM` e separa più fasce orarie con una virgola. Lascia vuoto per indicare chiuso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use `HH:MM-HH:MM` e separe várias janelas com vírgulas. Deixe em branco para fechado."
          }
        }
      }
    },
    "adminHours.googlePreviewBody": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull a candidate from Google Places, inspect the match, then save only if it looks right."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hent en kandidat fra Google Places, inspiser treffet, og lagre kun hvis det ser riktig ut."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Places'ten bir aday çek, eşleşmeyi incele, sadece doğru görünüyorsa kaydet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtén un candidato de Google Places, revisa la coincidencia y guarda solo si es correcta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rufe einen Kandidaten von Google Places ab, prüfe die Übereinstimmung und speichere nur, wenn sie stimmt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Récupère un candidat depuis Google Places, vérifie la correspondance, puis enregistre seulement si tout semble correct."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Recupera un candidato da Google Places, controlla la corrispondenza e salva solo se è corretta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Busque um candidato no Google Places, analise a correspondência e salve somente se estiver correto."
          }
        }
      }
    },
