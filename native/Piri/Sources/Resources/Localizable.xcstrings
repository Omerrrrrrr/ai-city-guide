    "onboarding.faithInterests.faithNote": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilft Piri, sakrale und historische Orte passend einzuordnen — eine Moschee wird einem Muslim anders erklärt als einem Architekten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Helps Piri frame sacred and historic spaces — a mosque explained to a Muslim differs from one explained to an architect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayuda a Piri a presentar espacios sagrados e históricos: una mezquita se explica de forma distinta a un musulmán que a un arquitecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aide Piri à présenter les lieux sacrés et historiques — une mosquée expliquée à un musulman diffère de celle expliquée à un architecte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aiuta Piri a presentare al meglio luoghi sacri e storici — una moschea spiegata a un musulmano è diversa da una spiegata a un architetto."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjelper Piri med å ramme inn hellige og historiske steder — en moské forklart til en muslim er annerledes enn forklart til en arkitekt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuda o Piri a apresentar espaços sagrados e históricos — uma mesquita explicada para um muçulmano é diferente de uma explicada para um arquiteto."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Piri'nin kutsal ve tarihi mekânları çerçevelemesine yardımcı olur — bir camii Müslüman birine anlatıldığında, bir mimara anlatılandan farklıdır."
          }
        }
      }
    },
