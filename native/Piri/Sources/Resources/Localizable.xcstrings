    "saved.collections.noListsBody": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle eine benannte Liste, um deine gespeicherten Orte zu gruppieren — etwa „Wochenendtrip“ oder „Restaurants zum Ausprobieren“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a named list to group your saved places — like \"Weekend trip\" or \"Restaurants to try\"."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una lista con nombre para agrupar tus lugares guardados, como \"Escapada de fin de semana\" o \"Restaurantes por probar\"."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée une liste pour regrouper tes lieux enregistrés — comme « Weekend » ou « Restaurants à essayer »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una lista con un nome per raggruppare i tuoi luoghi salvati — ad esempio \"Weekend fuori porta\" o \"Ristoranti da provare\"."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lag en navngitt liste for å gruppere lagrede steder — som \"Helgetur\" eller \"Restauranter å prøve\"."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie uma lista com nome para agrupar seus locais salvos — como \"Viagem de fim de semana\" ou \"Restaurantes para experimentar\"."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydettiğin yerleri gruplamak için isimli bir liste oluştur — \"Hafta sonu gezisi\" veya \"Denenecek restoranlar\" gibi."
          }
        }
