DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/aicityguide
PORT=4000
# Optional until AI recommendations are enabled.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Optional when both AI providers are configured.
AI_PROVIDER=openai
# Optional until Google-based hours preview is enabled in Hours Review.
GOOGLE_MAPS_API_KEY=
APP_URL=http://localhost:4000
# Optional: enables GET /weather endpoint (proxies OpenWeatherMap). Free tier at openweathermap.org
OPENWEATHER_API_KEY=
# Required to enable /admin/* routes (image review, hours review). Generate with:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Without this set, all /admin/* routes return 503.
ADMIN_API_TOKEN=
# Required to enable accounts (POST /auth/*, GET+PUT /me*). Signs the app's
# own session tokens. Generate with:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Without this set, all /auth/* and /me* routes return 503.
AUTH_JWT_SECRET=
# The native app's bundle ID, checked against the `aud` claim of Sign in with
# Apple identity tokens. Matches PRODUCT_BUNDLE_IDENTIFIER in project.yml.
APPLE_BUNDLE_ID=com.piriapp.piri
# Comma-separated list of allowed browser origins (web build only; native app calls are unaffected).
# Defaults to localhost dev ports when unset.
CORS_ORIGINS=
# Optional: reports uncaught/logged errors to Sentry. Leave blank to disable (no-op).
SENTRY_DSN=
# Optional: enables POST /routes/directions (real walking/driving routes for
# the trip planner) and a last-resort reverse-geocode address fallback during
# city discovery. Free tier (no credit card) at openrouteservice.org.
OPENROUTESERVICE_API_KEY=
# Optional: attaches a Tripadvisor rating to /places/explain-poi responses.
# Self-serve key (no approval wait, first 1,000 calls free) at
# tripadvisor.com/developers — sign up for Terra, not the legacy Content API
# (sunsetting 2026-08-31).
TRIPADVISOR_API_KEY=
# Required to enable real push delivery (city-discovery-ready notifications).
# Generate an APNs Auth Key in Apple Developer -> Certificates, Identifiers &
# Profiles -> Keys (check "Apple Push Notifications service"), matching
# Bundle ID com.piriapp.piri. Without these set, notifications are logged but
# not sent.
APNS_KEY_ID=
APNS_TEAM_ID=
# Paste the .p8 file's contents here with literal `\n` for newlines.
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=com.piriapp.piri
# sandbox while developing/TestFlight-via-Xcode; production once shipped
# through App Store Connect.
APNS_ENVIRONMENT=sandbox
