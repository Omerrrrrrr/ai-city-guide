    "home.aiBanner.sub": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell me what you feel like — I'll find the perfect spot."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Si hva du har lyst på — jeg finner det perfekte stedet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne canın istiyor söyle — sana en uygun yeri bulayım."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuéntame qué te apetece y encontraré el lugar perfecto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag mir, wonach dir ist — ich finde den perfekten Ort."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dis-moi ce qui te ferait plaisir — je trouverai l'endroit parfait."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimmi cosa ti va di fare — troverò il posto perfetto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Me conta o que você quer fazer — eu encontro o lugar perfeito."
          }
        }
      }
    },
