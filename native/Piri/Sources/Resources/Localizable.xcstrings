    "saved.plan.noPlansBody": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle einen benannten Plan, um daraus eine Route zu bauen — etwa „Wochenendtrip“ oder „Sommerurlaub“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a named plan to build a route from — like \"Weekend trip\" or \"Summer holiday\"."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un plan con nombre para armar una ruta, como \"Escapada de fin de semana\" o \"Vacaciones de verano\"."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée un plan nommé pour construire un itinéraire — comme « Weekend » ou « Vacances d'été »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un piano con un nome da cui costruire un percorso — ad esempio \"Weekend fuori porta\" o \"Vacanza estiva\"."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lag en navngitt plan for å bygge en rute fra — som \"Helgetur\" eller \"Sommerferie\"."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie um plano com nome para montar uma rota a partir dele — como \"Viagem de fim de semana\" ou \"Férias de verão\"."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir rota oluşturmak için isimli bir plan yap — \"Hafta sonu gezisi\" veya \"Yaz tatili\" gibi."
          }
        }
      }
    },
