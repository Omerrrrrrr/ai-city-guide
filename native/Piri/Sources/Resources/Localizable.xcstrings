    "poiReviews.moreOnTripadvisor": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld von %2$lld Bewertungen werden angezeigt — Tripadvisors kostenlose API zeigt nur die neuesten paar. Den Rest findest du auf Tripadvisor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Showing %1$lld of %2$lld reviews — Tripadvisor's free API only exposes their most recent few. See the rest on Tripadvisor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrando %1$lld de %2$lld reseñas: la API gratuita de Tripadvisor solo expone las más recientes. Ve el resto en Tripadvisor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichage de %1$lld avis sur %2$lld — l'API gratuite de Tripadvisor n'expose que les plus récents. Retrouve les autres sur Tripadvisor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualizzate %1$lld di %2$lld recensioni — l'API gratuita di Tripadvisor mostra solo le più recenti. Vedi le altre su Tripadvisor."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser %1$lld av %2$lld anmeldelser — Tripadvisors gratis API viser bare de nyeste. Se resten på Tripadvisor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrando %1$lld de %2$lld avaliações — a API gratuita do Tripadvisor só disponibiliza as mais recentes. Veja o restante no Tripadvisor."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld yorumdan %1$lld tanesi gösteriliyor — Tripadvisor'ın ücretsiz API'si sadece en yenilerini veriyor. Kalanını Tripadvisor'da görebilirsin."
          }
        }
      }
    },
