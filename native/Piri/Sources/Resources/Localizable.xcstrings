    "onboarding.faithInterests.subtitle": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beides optional. Überspringe alles, was du nicht teilen möchtest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both optional. Skip anything you'd rather not share."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambos son opcionales. Omite lo que prefieras no compartir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux sont facultatifs. Passe ce que tu préfères ne pas partager."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrambi facoltativi. Salta ciò che preferisci non condividere."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Begge deler er valgfrie. Hopp over det du ikke ønsker å dele."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambos são opcionais. Pule o que preferir não compartilhar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İkisi de isteğe bağlı. Paylaşmak istemediğin bir şeyi atlayabilirsin."
          }
        }
      }
    },
