    "scan.permission.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point your camera at any place in the world and Piri will explain it — tailored to who you are."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pek kameraet mot et hvilket som helst sted i verden, så forklarer Piri det — tilpasset deg."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameranı dünyanın herhangi bir yerindeki bir mekana doğrult, Piri sana özel anlatsın."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apunta tu cámara a cualquier lugar del mundo y Piri te lo explicará, adaptado a quién eres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richte deine Kamera auf einen beliebigen Ort auf der Welt, und Piri erklärt ihn dir — zugeschnitten auf dich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pointe ta caméra vers n'importe quel lieu dans le monde et Piri te l'expliquera — adapté à qui tu es."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Punta la fotocamera verso qualsiasi luogo nel mondo e Piri te lo spiegherà — su misura per te."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aponte sua câmera para qualquer lugar do mundo e o Piri vai explicá-lo — personalizado para quem você é."
          }
        }
      }
    },
