    "trip.delete.message": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden die Reise, ihre Route und alle hinzugefügten Fotos endgültig gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently deletes the trip, its route, and any photos you added."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina permanentemente el viaje, su ruta y las fotos que hayas añadido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime définitivement le voyage, son itinéraire et les photos que tu as ajoutées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa azione eliminerà definitivamente il viaggio, il suo percorso e tutte le foto aggiunte."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette sletter turen, ruten og eventuelle bilder permanent."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso exclui permanentemente a viagem, sua rota e todas as fotos que você adicionou."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, seyahati, rotasını ve eklediğin fotoğrafları kalıcı olarak siler."
          }
        }
      }
    },
