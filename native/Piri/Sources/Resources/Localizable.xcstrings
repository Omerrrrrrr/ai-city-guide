    "cityPicker.hintBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search a city and Piri will discover places there using global map data. First discovery takes 1-2 minutes."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Søk etter en by, så oppdager Piri steder der ved hjelp av globale kartdata. Første utforsking tar 1-2 minutter."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir şehir ara, Piri küresel harita verilerini kullanarak oradaki yerleri keşfetsin. İlk keşif 1-2 dakika sürer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca una ciudad y Piri descubrirá lugares allí usando datos de mapas globales. El primer descubrimiento tarda de 1 a 2 minutos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suche eine Stadt und Piri entdeckt dort Orte anhand globaler Kartendaten. Die erste Entdeckung dauert 1-2 Minuten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche une ville et Piri y découvrira des lieux grâce aux données cartographiques mondiales. La première découverte prend 1 à 2 minutes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca una città e Piri troverà i luoghi da visitare usando dati di mappe globali. La prima ricerca richiede 1-2 minuti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Busque uma cidade e o Piri vai descobrir os locais usando dados globais de mapas. A primeira descoberta leva de 1 a 2 minutos."
          }
        }
      }
    },
