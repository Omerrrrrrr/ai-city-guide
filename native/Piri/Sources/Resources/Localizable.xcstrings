    "collection.dateSubtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you'll start this plan — used to check whether each place will be open yet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
