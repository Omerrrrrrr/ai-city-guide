    "onboarding.name.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional — used to personalize how Piri talks to you."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsteğe bağlı — Piri'nin seninle konuşma şeklini kişiselleştirmek için kullanılır."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgfritt — brukes til å tilpasse hvordan Piri snakker med deg."
          }
        }
      }
    },
    "onboarding.name.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What should we call you?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sana nasıl hitap edelim?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hva skal vi kalle deg?"
          }
        }
      }
    },
    "onboarding.profession.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Piri tailors its explanations to your expertise. An architect hears about structure; a historian about context."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Piri açıklamalarını uzmanlığına göre uyarlar. Bir mimar yapıyı duyar; bir tarihçi bağlamı."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Piri tilpasser forklaringene til din ekspertise. En arkitekt hører om struktur; en historiker om kontekst."
          }
        }
      }
    },
    "onboarding.profession.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What do you do?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne iş yapıyorsun?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hva jobber du med?"
          }
        }
      }
    },
