          }
        }
      }
    },
    "onboarding.faithInterests.faithNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Helps Piri frame sacred and historic spaces — a mosque explained to a Muslim differs from one explained to an architect."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Piri'nin kutsal ve tarihi mekânları çerçevelemesine yardımcı olur — bir camii Müslüman birine anlatıldığında, bir mimara anlatılandan farklıdır."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjelper Piri med å ramme inn hellige og historiske steder — en moské forklart til en muslim er annerledes enn forklart til en arkitekt."
          }
        }
      }
    },
    "onboarding.faithInterests.interestsLabel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interests"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlgi alanları"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Interesser"
          }
        }
      }
    },
    "onboarding.faithInterests.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both optional. Skip anything you'd rather not share."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İkisi de isteğe bağlı. Paylaşmak istemediğin bir şeyi atlayabilirsin."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Begge deler er valgfrie. Hopp over det du ikke ønsker å dele."
          }
        }
      }
    },
    "onboarding.faithInterests.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bit more about you"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seni biraz daha tanıyalım"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Litt mer om deg"
          }
        }
      }
    },
    "onboarding.name.placeholder": {
      "localizations": {
