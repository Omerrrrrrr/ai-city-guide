    },
    "adminHours.hero.body1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere verifizierte Öffnungszeiten, Quellenlinks und vorübergehende Schließungen, ohne die Ausgangsdaten zu bearbeiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save verified opening hours, source links, and temporary closures without editing seed data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda horarios verificados, enlaces de origen y cierres temporales sin editar los datos base."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre des horaires vérifiés, des liens sources et des fermetures temporaires sans modifier les données d'origine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva orari di apertura verificati, link alle fonti e chiusure temporanee senza modificare i dati di partenza."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagre verifiserte åpningstider, kildelenker og midlertidige stenginger uten å redigere seed-data."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve horários de funcionamento verificados, links de origem e fechamentos temporários sem editar os dados base."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seed veriyi düzenlemeden doğrulanmış çalışma saatlerini, kaynak linklerini ve geçici kapanışları kaydet."
          }
        }
      }
    },
    "adminHours.hero.body2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Google-Vorschau füllt das Formular nur vorab aus. Nichts wird live geschaltet, bevor du es geprüft und auf „Öffnungszeiten speichern“ getippt hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google preview only prefills the form. Nothing becomes live until you inspect it and press Save Hours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La vista previa de Google solo rellena el formulario. Nada se publica hasta que lo revises y pulses Guardar horario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'aperçu Google ne fait que préremplir le formulaire. Rien n'est publié tant que tu ne l'as pas vérifié et cliqué sur Enregistrer les horaires."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'anteprima Google compila solo il modulo. Niente diventa attivo finché non lo controlli e premi Salva orari."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Google-forhåndsvisning fyller kun ut skjemaet. Ingenting blir live før du inspiserer det og trykker Lagre åpningstider."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A prévia do Google só preenche o formulário automaticamente. Nada entra no ar até você revisar e tocar em Salvar Horários."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google önizlemesi sadece formu doldurur. Sen inceleyip Saatleri Kaydet'e basana kadar hiçbir şey canlıya çıkmaz."
          }
        }
      }
    },
