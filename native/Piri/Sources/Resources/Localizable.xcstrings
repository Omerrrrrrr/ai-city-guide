    "adminImages.hero.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review pending Wikimedia candidates, then approve and apply real photos to places."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjennomgå ventende Wikimedia-kandidater, og godkjenn og bruk ekte bilder på steder."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekleyen Wikimedia adaylarını incele, sonra gerçek fotoğrafları onaylayıp yerlere uygula."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa los candidatos pendientes de Wikimedia y luego aprueba y aplica fotos reales a los lugares."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe ausstehende Wikimedia-Kandidaten und genehmige und wende dann echte Fotos auf Orte an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Examine les candidats Wikimedia en attente, puis approuve et applique de vraies photos aux lieux."
