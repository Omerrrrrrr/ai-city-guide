    },
    "adminHours.hero.body2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google preview only prefills the form. Nothing becomes live until you inspect it and press Save Hours."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Google-forhåndsvisning fyller kun ut skjemaet. Ingenting blir live før du inspiserer det og trykker Lagre åpningstider."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google önizlemesi sadece formu doldurur. Sen inceleyip Saatleri Kaydet'e basana kadar hiçbir şey canlıya çıkmaz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La vista previa de Google solo rellena el formulario. Nada se publica hasta que lo revises y pulses Guardar horario."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Google-Vorschau füllt das Formular nur vorab aus. Nichts wird live geschaltet, bevor du es geprüft und auf „Öffnungszeiten speichern“ getippt hast."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'aperçu Google ne fait que préremplir le formulaire. Rien n'est publié tant que tu ne l'as pas vérifié et cliqué sur Enregistrer les horaires."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'anteprima Google compila solo il modulo. Niente diventa attivo finché non lo controlli e premi Salva orari."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A prévia do Google só preenche o formulário automaticamente. Nada entra no ar até você revisar e tocar em Salvar Horários."
          }
        }
      }
    },
