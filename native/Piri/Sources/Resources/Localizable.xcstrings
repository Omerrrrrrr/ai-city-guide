    "saved.collections.emptyBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search above to add a place, or add one from any place's detail page."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Søk over for å legge til et sted, eller legg til fra et steds detaljside."
