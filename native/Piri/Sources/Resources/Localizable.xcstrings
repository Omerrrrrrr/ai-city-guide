    "cityPicker.hintBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search a city and Piri will discover places there using global map data. First discovery takes 1-2 minutes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir şehir ara, Piri küresel harita verilerini kullanarak oradaki yerleri keşfetsin. İlk keşif 1-2 dakika sürer."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Søk etter en by, så oppdager Piri steder der ved hjelp av globale kartdata. Første utforsking tar 1-2 minutter."
          }
        }
      }
    },
