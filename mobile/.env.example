# Optional in development. If omitted, the app derives a local base URL automatically.
EXPO_PUBLIC_API_URL=http://127.0.0.1:4000
# Optional: reports crashes/errors to Sentry. Leave blank to disable (no-op).
# Only takes effect in a dev client / EAS / standalone build — Expo Go can't load it.
EXPO_PUBLIC_SENTRY_DSN=
