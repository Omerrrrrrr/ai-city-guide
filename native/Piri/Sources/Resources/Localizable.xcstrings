    "home.aiBanner.sub": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag mir, wonach dir ist — ich finde den perfekten Ort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell me what you feel like — I'll find the perfect spot."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuéntame qué te apetece y encontraré el lugar perfecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dis-moi ce qui te ferait plaisir — je trouverai l'endroit parfait."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimmi cosa ti va di fare — troverò il posto perfetto."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Si hva du har lyst på — jeg finner det perfekte stedet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Me conta o que você quer fazer — eu encontro o lugar perfeito."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne canın istiyor söyle — sana en uygun yeri bulayım."
          }
        }
      }
    },
    "home.aiBanner.title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag Piri irgendwas"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask Piri anything"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntale a Piri lo que sea"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande n'importe quoi à Piri"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi a Piri qualsiasi cosa"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spør Piri om hva som helst"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunte qualquer coisa ao Piri"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Piri'ye her şeyi sor"
          }
        }
      }
    },
