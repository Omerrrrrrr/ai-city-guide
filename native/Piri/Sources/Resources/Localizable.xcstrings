      "comment": "A secondary line of text below the place name, showing the category of the place.",
      "isCommentAutoGenerated": true
    },
    " %@%@": {
      "comment": "Displays the category of a place, optionally including a tag. The first argument is the system name of an image representing the place category. The second argument is the localized label for the place category. If the place has a tag, it is appended as a subtitle.",
