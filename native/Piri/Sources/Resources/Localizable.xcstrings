    "home.cityEmpty.body": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discovery may still be processing. Pull to refresh, or try exploring a different city."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Utforskingen kan fortsatt pågå. Dra for å oppdatere, eller prøv en annen by."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Keşif hâlâ işleniyor olabilir. Yenilemek için aşağı çek, ya da farklı bir şehir dene."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El descubrimiento podría seguir en proceso. Desliza para actualizar o explora otra ciudad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Entdeckung läuft eventuell noch. Zieh zum Aktualisieren nach unten oder erkunde eine andere Stadt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La découverte est peut-être encore en cours. Tire pour actualiser ou explore une autre ville."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La ricerca potrebbe essere ancora in corso. Trascina per aggiornare o prova a esplorare un'altra città."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A descoberta ainda pode estar em andamento. Puxe para atualizar ou explore outra cidade."
          }
        }
      }
    },
