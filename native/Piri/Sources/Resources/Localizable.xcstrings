    "saved.optimize.query": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich plane, Folgendes zu besuchen: %1$@. Schlag mir die beste Reihenfolge für heute vor, mit geschätzter Zeit für jeden Ort und Tipps zu Fuß- oder Verkehrswegen dazwischen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm planning to visit: %1$@. Suggest the best order to visit them today, with estimated time at each and any walking or transport tips between them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Planeo visitar: %1$@. Sugiere el mejor orden para visitarlos hoy, con el tiempo estimado en cada uno y consejos de desplazamiento o transporte entre ellos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je prévois de visiter : %1$@. Suggère le meilleur ordre pour les visiter aujourd'hui, avec le temps estimé à chaque endroit et des conseils de trajet à pied ou en transport entre eux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho intenzione di visitare: %1$@. Suggerisci l'ordine migliore per visitarli oggi, con il tempo stimato per ognuno ed eventuali consigli su spostamenti a piedi o con mezzi di trasporto."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg planlegger å besøke: %1$@. Foreslå den beste rekkefølgen å besøke dem i dag, med anslått tid på hvert sted og eventuelle gå- eller transporttips mellom dem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estou planejando visitar: %1$@. Sugira a melhor ordem para visitá-los hoje, com o tempo estimado em cada um e dicas de caminhada ou transporte entre eles."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şunları ziyaret etmeyi planlıyorum: %1$@. Bugün ziyaret etmek için en iyi sırayı, her birinde tahmini süreyi ve aralarındaki yürüyüş veya ulaşım ipuçlarını öner."
          }
        }
      }
    },
