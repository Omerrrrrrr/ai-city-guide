    "onboarding.travelStyle.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Helps Piri match the pace, budget, and vibe of what it suggests."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsteğe bağlı. Piri'nin önerdiği tempo, bütçe ve atmosferi eşleştirmesine yardımcı olur."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgfritt. Hjelper Piri med å matche tempoet, budsjettet og stemningen i det som foreslås."
          }
        }
      }
    },
    "onboarding.travelStyle.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How do you like to travel?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasıl seyahat etmeyi seversin?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvordan liker du å reise?"
          }
        }
      }
    },
    "onboarding.welcomeBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answer a few questions and Piri will explain every place — every monument, mosque, ruin, restaurant — through the lens of who you are."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birkaç soruyu cevapla, Piri her yeri — her anıtı, camiyi, harabeyi, restoranı — senin bakış açından anlatsın."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Svar på noen få spørsmål, så forklarer Piri hvert sted — hvert monument, moské, ruin, restaurant — gjennom ditt eget perspektiv."
          }
        }
      }
    },
