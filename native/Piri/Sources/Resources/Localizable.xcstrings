    "home.profileNudge.body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erzähl uns, wer du bist — derselbe Ort wird einem Architekten, einem Muslim oder einem Historiker unterschiedlich erklärt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell us who you are — same place explained differently to an architect, a Muslim, a historian."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuéntanos quién eres: el mismo lugar se explica de forma distinta a un arquitecto, a un musulmán o a un historiador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dis-nous qui tu es — le même lieu s'explique différemment à un architecte, un musulman, un historien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raccontaci chi sei — lo stesso luogo viene spiegato in modo diverso a un architetto, a un musulmano, a uno storico."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortell oss hvem du er — samme sted forklart ulikt til en arkitekt, en muslim, en historiker."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conte quem você é — o mesmo lugar é explicado de um jeito diferente para um arquiteto, um muçulmano, um historiador."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kim olduğunu bize anlat — aynı mekân bir mimara, bir Müslümana, bir tarihçiye farklı anlatılır."
          }
        }
      }
    },
