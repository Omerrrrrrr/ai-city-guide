    "onboarding.travelStyle.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Helps Piri match the pace, budget, and vibe of what it suggests."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgfritt. Hjelper Piri med å matche tempoet, budsjettet og stemningen i det som foreslås."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsteğe bağlı. Piri'nin önerdiği tempo, bütçe ve atmosferi eşleştirmesine yardımcı olur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Ayuda a Piri a ajustar el ritmo, el presupuesto y el estilo de lo que sugiere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Hilft Piri, Tempo, Budget und Stimmung der Vorschläge anzupassen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif. Aide Piri à adapter le rythme, le budget et l'ambiance de ses suggestions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativo. Aiuta Piri ad adattare ritmo, budget e atmosfera dei suoi consigli."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Ajuda o Piri a combinar o ritmo, o orçamento e o estilo do que sugere."
          }
        }
      }
    },
    "onboarding.travelStyle.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How do you like to travel?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvordan liker du å reise?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasıl seyahat etmeyi seversin?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cómo te gusta viajar?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie reist du am liebsten?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment aimes-tu voyager ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come ti piace viaggiare?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como você gosta de viajar?"
          }
        }
      }
    },
    "onboarding.welcomeBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answer a few questions and Piri will explain every place — every monument, mosque, ruin, restaurant — through the lens of who you are."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Svar på noen få spørsmål, så forklarer Piri hvert sted — hvert monument, moské, ruin, restaurant — gjennom ditt eget perspektiv."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birkaç soruyu cevapla, Piri her yeri — her anıtı, camiyi, harabeyi, restoranı — senin bakış açından anlatsın."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Responde algunas preguntas y Piri te explicará cada lugar (cada monumento, mezquita, ruina o restaurante) desde tu propia perspectiva."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beantworte ein paar Fragen und Piri erklärt dir jeden Ort — jedes Denkmal, jede Moschee, jede Ruine, jedes Restaurant — aus deiner ganz persönlichen Perspektive."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réponds à quelques questions et Piri t'expliquera chaque lieu — chaque monument, mosquée, ruine, restaurant — à travers le prisme de qui tu es."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rispondi a qualche domanda e Piri ti spiegherà ogni luogo — monumenti, moschee, rovine, ristoranti — dal tuo punto di vista."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Responda algumas perguntas e o Piri vai explicar cada lugar — cada monumento, mesquita, ruína, restaurante — sob a perspectiva de quem você é."
          }
        }
      }
    },
